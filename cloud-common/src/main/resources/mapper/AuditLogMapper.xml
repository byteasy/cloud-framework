<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.byteasy.common.mapper.IAuditLogMapper">

    <!-- 基础 ResultMap 映射 -->
    <resultMap id="BaseResultMap" type="com.byteasy.entity.AuditLog">
        <id column="id" property="id" />
        <result column="entity_id" property="entityId" />
        <result column="change_type" property="changeType" />
        <result column="entity_content" property="entityContent" />
        <!-- 继承自 ImmutablyEntity 的公共审计字段（按你基类的实际属性名对齐） -->
        <result column="creator_id" property="creatorId" />
        <result column="created_by" property="createdBy" />
        <result column="created_time" property="createdTime" />
    </resultMap>

    <!-- 通用查询字段列 -->
    <sql id="Base_Column_List">
        id, entity_id, change_type, entity_content, creator_id, created_by, created_time
    </sql>

    <!-- 1. 批量插入（表名动态传入必须使用 ${tableName}，不可用 #{tableName}） -->
    <insert id="batchInsert">
        INSERT INTO ${tableName} (
        entity_id,
        change_type,
        entity_content,
        creator_id,
        created_by,
        created_time
        ) VALUES
        <foreach collection="auditLogs" item="item" separator=",">
            (
            #{item.entityId},
            #{item.changeType},
            #{item.entityContent},
            #{item.creatorId},
            #{item.createdBy},
            #{item.createdTime}
            )
        </foreach>
    </insert>

    <!-- 2. 分页列表查询 -->
    <select id="queryForList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM ${tableName}
        <where>
            <if test="entityId != null">
                AND entity_id = #{entityId}
            </if>
            <if test="start != null">
                AND created_time &gt;= #{start}
            </if>
            <if test="end != null">
                AND created_time &lt;= #{end}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{pageSize} OFFSET #{current}
    </select>

    <!-- 3. 查询分页总记录数 -->
    <select id="countForPage" resultType="long">
        SELECT COUNT(1)
        FROM ${tableName}
        <where>
            <if test="entityId != null">
                AND entity_id = #{entityId}
            </if>
            <if test="start != null">
                AND created_time &gt;= #{start}
            </if>
            <if test="end != null">
                AND created_time &lt;= #{end}
            </if>
        </where>
    </select>

</mapper>